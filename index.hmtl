<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>FinanceApp - Gestión Elite</title>
    <!-- Tailwind CSS para Estilos -->
    <script src="https://cdn.tailwindcss.com"></script>
    <!-- React y ReactDOM -->
    <script src="https://unpkg.com/react@18/umd/react.production.min.js"></script>
    <script src="https://unpkg.com/react-dom@18/umd/react-dom.production.min.js"></script>
    <!-- Babel para JSX en el navegador -->
    <script src="https://unpkg.com/@babel/standalone/babel.min.js"></script>
    <!-- Recharts para Gráficos -->
    <script src="https://unpkg.com/recharts/umd/Recharts.js"></script>
    <!-- Lucide Icons -->
    <script src="https://unpkg.com/lucide@latest"></script>
    <style>
        @import url('https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap');
        body { font-family: 'Inter', sans-serif; }
        input::-webkit-outer-spin-button, input::-webkit-inner-spin-button { -webkit-appearance: none; margin: 0; }
        .custom-scrollbar::-webkit-scrollbar { width: 4px; }
        .custom-scrollbar::-webkit-scrollbar-track { background: transparent; }
        .custom-scrollbar::-webkit-scrollbar-thumb { background: #e2e8f0; border-radius: 10px; }
    </style>
</head>
<body class="bg-slate-50">
    <div id="root"></div>

    <script type="text/babel">
        const { useState, useMemo, useEffect } = React;
        const { 
            PieChart, Pie, Cell, ResponsiveContainer, 
            XAxis, YAxis, Tooltip, Legend, BarChart, Bar, CartesianGrid, LabelList 
        } = Recharts;

        // Iconos de Lucide adaptados para React en HTML
        const Icon = ({ name, size = 18, color = "currentColor", strokeWidth = 2, className = "" }) => {
            useEffect(() => {
                lucide.createIcons();
            }, [name]);
            return <i data-lucide={name} className={className} style={{ width: size, height: size, strokeWidth: strokeWidth, color: color }}></i>;
        };

        const MONTHS = [
            'Enero', 'Febrero', 'Marzo', 'Abril', 'Mayo', 'Junio', 
            'Julio', 'Agosto', 'Septiembre', 'Octubre', 'Noviembre', 'Diciembre'
        ];
        const TAGS = ['Belleza', 'Salidas', 'Efectivo', 'Compras', 'Uber', 'Comida'];
        const COLORS = ['#4f46e5', '#db2777', '#0ea5e9', '#059669', '#d97706', '#7c3aed'];

        const App = () => {
            const [activeTab, setActiveTab] = useState('Enero');
            const [isMobileMode, setIsMobileMode] = useState(false);
            const [showMonthSelector, setShowMonthSelector] = useState(false);
            
            const [data, setData] = useState({
                config: { pNec: 50, pDes: 30, pAho: 20 },
                loans: [],
                monthly: MONTHS.reduce((acc, month) => {
                    acc[month] = {
                        salario: 0, entradas: 0, mesPasado: 0, prestado: 0,
                        ahorroManual: 0, gastosFijos: [], gastosVariables: []
                    };
                    return acc;
                }, {})
            });

            const fmt = (val) => val.toLocaleString('es-ES', { style: 'currency', currency: 'EUR' });

            // Handlers
            const updateConfig = (field, value) => {
                setData(prev => ({ ...prev, config: { ...prev.config, [field]: parseInt(value) || 0 } }));
            };

            const addLoan = (nombre, monto) => {
                if (!nombre || !monto) return;
                const newLoan = { id: Date.now(), nombre, monto: parseFloat(monto), pagado: false, fecha: new Date().toLocaleDateString('es-ES') };
                setData(prev => ({ ...prev, loans: [newLoan, ...prev.loans] }));
            };

            const toggleLoanStatus = (id) => {
                setData(prev => ({ ...prev, loans: prev.loans.map(l => l.id === id ? { ...l, pagado: !l.pagado } : l) }));
            };

            const deleteLoan = (id) => {
                setData(prev => ({ ...prev, loans: prev.loans.filter(l => l.id !== id) }));
            };

            const updateMonth = (month, field, value) => {
                setData(prev => ({
                    ...prev,
                    monthly: { ...prev.monthly, [month]: { ...prev.monthly[month], [field]: parseFloat(value) || 0 } }
                }));
            };

            const addGasto = (month, type) => {
                const newItem = { id: Date.now(), nombre: '', valor: 0, tag: TAGS[0] };
                setData(prev => ({
                    ...prev,
                    monthly: { ...prev.monthly, [month]: { ...prev.monthly[month], [type]: [...prev.monthly[month][type], newItem] } }
                }));
            };

            const updateGasto = (month, type, id, field, value) => {
                setData(prev => ({
                    ...prev,
                    monthly: {
                        ...prev.monthly,
                        [month]: {
                            ...prev.monthly[month],
                            [type]: prev.monthly[month][type].map(item => item.id === id ? { ...item, [field]: field === 'valor' ? parseFloat(value) || 0 : value } : item)
                        }
                    }
                }));
            };

            const deleteGasto = (month, type, id) => {
                setData(prev => ({
                    ...prev,
                    monthly: { ...prev.monthly, [month]: { ...prev.monthly[month], [type]: prev.monthly[month][type].filter(item => item.id !== id) } }
                }));
            };

            // Lógica
            const currentMonthData = data.monthly[activeTab] || {};
            const totalIngresos = (currentMonthData.salario || 0) + (currentMonthData.entradas || 0) + (currentMonthData.mesPasado || 0) + (currentMonthData.prestado || 0);
            const baseCalculo = Math.max(0, totalIngresos - (currentMonthData.ahorroManual || 0));
            const valNec = baseCalculo * (data.config.pNec / 100);
            const valDes = baseCalculo * (data.config.pDes / 100);
            const valAhoExtra = baseCalculo * (data.config.pAho / 100);
            const totalGastosFijos = currentMonthData.gastosFijos?.reduce((sum, g) => sum + g.valor, 0) || 0;
            const totalGastosVar = currentMonthData.gastosVariables?.reduce((sum, g) => sum + g.valor, 0) || 0;
            const totalGastadoTotal = totalGastosFijos + totalGastosVar;
            const dineroDisponibleVista = (valNec + valDes) - totalGastadoTotal;

            const isConfigValid = (data.config.pNec + data.config.pDes + data.config.pAho) === 100;
            const isNecOver = totalGastosFijos > valNec;
            const isDesOver = totalGastosVar > valDes;

            const categoryData = useMemo(() => {
                const counts = {};
                TAGS.forEach(tag => counts[tag] = 0);
                currentMonthData.gastosVariables?.forEach(g => counts[g.tag] = (counts[g.tag] || 0) + g.valor);
                return Object.keys(counts).map(tag => ({ name: tag, value: counts[tag] })).filter(d => d.value > 0);
            }, [currentMonthData]);

            const savingsAnalytics = MONTHS.map(m => {
                const mData = data.monthly[m];
                const mIngresos = (mData.salario || 0) + (mData.entradas || 0) + (mData.mesPasado || 0) + (mData.prestado || 0);
                const mBase = Math.max(0, mIngresos - (mData.ahorroManual || 0));
                const remanente = Math.max(0, (mBase * ((data.config.pNec + data.config.pDes) / 100)) - ((mData.gastosFijos?.reduce((s, g) => s + g.valor, 0) || 0) + (mData.gastosVariables?.reduce((s, g) => s + g.valor, 0) || 0)));
                return { month: m, ingresos: mIngresos, total: (mData.ahorroManual || 0) + (mBase * (data.config.pAho / 100)) + remanente };
            });

            const totalAhorroAnual = savingsAnalytics.reduce((sum, s) => sum + s.total, 0);

            return (
                <div className={`flex h-screen bg-slate-50 text-slate-700 transition-all duration-300 ${isMobileMode ? 'justify-center items-center p-2 sm:p-6' : ''}`}>
                    
                    <button onClick={() => { setIsMobileMode(!isMobileMode); setShowMonthSelector(false); }} className="fixed bottom-6 right-6 z-[100] bg-indigo-600 text-white p-3.5 rounded-2xl shadow-lg hover:bg-indigo-700 transition-all flex items-center gap-2">
                        <Icon name={isMobileMode ? "monitor" : "smartphone"} size={20} />
                        <span className="text-xs font-semibold uppercase hidden md:block">{isMobileMode ? 'PC' : 'Móvil'}</span>
                    </button>

                    {!isMobileMode && (
                        <aside className="w-64 bg-white border-r border-slate-200 flex flex-col shrink-0">
                            <div className="p-8 border-b border-slate-50 flex items-center gap-3">
                                <div className="bg-indigo-600 p-2 rounded-xl text-white shadow-md shadow-indigo-100"><Icon name="wallet" size={20} /></div>
                                <h1 className="font-bold text-xl tracking-tight text-slate-800">FinanceApp</h1>
                            </div>
                            <nav className="flex-1 overflow-y-auto p-4 space-y-1 custom-scrollbar">
                                <button onClick={() => setActiveTab('Ahorros')} className={`w-full flex items-center gap-3 px-4 py-3 rounded-xl transition-all font-semibold ${activeTab === 'Ahorros' ? 'bg-indigo-50 text-indigo-700' : 'text-slate-500 hover:bg-slate-50'}`}>
                                    <Icon name="piggy-bank" size={18} /> Ahorros
                                </button>
                                <button onClick={() => setActiveTab('Préstamos')} className={`w-full flex items-center gap-3 px-4 py-3 rounded-xl transition-all font-semibold ${activeTab === 'Préstamos' ? 'bg-indigo-50 text-indigo-700' : 'text-slate-500 hover:bg-slate-50'}`}>
                                    <Icon name="hand-coins" size={18} /> Préstamos
                                </button>
                                <div className="pt-6 pb-2 px-4 text-[10px] font-bold text-slate-400 uppercase tracking-widest">Meses</div>
                                {MONTHS.map(m => (
                                    <button key={m} onClick={() => setActiveTab(m)} className={`w-full flex items-center px-4 py-2.5 rounded-xl transition-all text-sm font-medium ${activeTab === m ? 'bg-slate-800 text-white' : 'text-slate-500 hover:bg-slate-50'}`}>
                                        {m}
                                    </button>
                                ))}
                            </nav>
                        </aside>
                    )}

                    <div className={`flex-1 flex flex-col transition-all duration-500 ${isMobileMode ? 'max-w-[390px] max-h-[800px] w-full h-full bg-white rounded-3xl border border-slate-200 shadow-2xl overflow-hidden relative' : 'overflow-hidden'}`}>
                        {isMobileMode && (
                            <header className="bg-white px-6 pt-10 pb-4 border-b border-slate-100 flex justify-between items-center sticky top-0 z-50">
                                <h2 className="font-bold text-slate-800 uppercase text-xs tracking-widest">{activeTab}</h2>
                                <div className="w-2 h-2 rounded-full bg-indigo-100" />
                            </header>
                        )}

                        <main className={`flex-1 overflow-y-auto custom-scrollbar ${isMobileMode ? 'p-5 pb-32' : 'p-8 lg:p-14'}`}>
                            {activeTab === 'Ahorros' && (
                                <div className="max-w-5xl mx-auto space-y-8 animate-in fade-in">
                                    <div className="bg-white rounded-2xl border border-slate-200 p-8 flex flex-wrap items-center justify-between gap-6 shadow-sm">
                                        <div>
                                            <h3 className="text-3xl font-bold text-slate-900 tracking-tight">Mi Patrimonio</h3>
                                            <p className="text-slate-500 text-sm mt-1">Suma total de ahorros anuales.</p>
                                        </div>
                                        <div className="bg-indigo-600 px-8 py-6 rounded-2xl text-white shadow-xl shadow-indigo-100 text-center">
                                            <span className="text-[10px] font-bold uppercase tracking-widest block opacity-70">Ahorro Acumulado</span>
                                            <span className="text-4xl font-bold">{fmt(totalAhorroAnual)}</span>
                                        </div>
                                    </div>
                                    <div className="bg-white border border-slate-200 rounded-2xl overflow-hidden shadow-sm">
                                        <table className="w-full text-left text-sm">
                                            <thead className="bg-slate-50 border-b border-slate-100 text-slate-400 font-bold uppercase text-[10px] tracking-widest">
                                                <tr><th className="px-6 py-4">Mes</th><th className="px-6 py-4">Ingresos</th><th className="px-6 py-4 text-right">Ahorro</th></tr>
                                            </thead>
                                            <tbody className="divide-y divide-slate-100">
                                                {savingsAnalytics.map((s, i) => (
                                                    <tr key={i} className="hover:bg-slate-50 transition-colors">
                                                        <td className="px-6 py-4 font-semibold text-slate-700">{s.month}</td>
                                                        <td className="px-6 py-4 text-slate-500">{fmt(s.ingresos)}</td>
                                                        <td className="px-6 py-4 text-right font-black text-indigo-600">{fmt(s.total)}</td>
                                                    </tr>
                                                ))}
                                            </tbody>
                                        </table>
                                    </div>
                                </div>
                            )}

                            {activeTab === 'Préstamos' && (
                                <div className="max-w-4xl mx-auto space-y-8">
                                    <div className="bg-white p-8 rounded-2xl border border-slate-200 shadow-sm space-y-6">
                                        <h3 className="font-bold text-slate-800 text-base flex items-center gap-2"><Icon name="user-plus" color="#4f46e5" /> Registrar Préstamo</h3>
                                        <form onSubmit={(e) => { e.preventDefault(); addLoan(e.target.nombre.value, e.target.monto.value); e.target.reset(); }} className={`flex gap-4 ${isMobileMode ? 'flex-col' : ''}`}>
                                            <input name="nombre" type="text" placeholder="Deudor" className="flex-1 bg-slate-50 border border-slate-200 rounded-xl px-4 py-3 text-sm font-medium focus:bg-white focus:ring-2 focus:ring-indigo-100 outline-none transition-all" required />
                                            <input name="monto" type="number" step="0.01" placeholder="Monto €" className={`bg-slate-50 border border-slate-200 rounded-xl px-4 py-3 text-sm font-bold focus:bg-white focus:ring-2 focus:ring-indigo-100 outline-none ${isMobileMode ? 'w-full' : 'w-40'}`} required />
                                            <button type="submit" className="bg-indigo-600 text-white px-8 py-3 rounded-xl text-xs font-bold uppercase tracking-widest shadow-md">Agregar</button>
                                        </form>
                                    </div>
                                    <div className="space-y-3">
                                        {data.loans.map(loan => (
                                            <div key={loan.id} className={`flex items-center justify-between p-5 rounded-2xl border shadow-sm transition-all ${loan.pagado ? 'bg-slate-50 border-slate-100 opacity-60' : 'bg-white'}`}>
                                                <div className="flex items-center gap-4">
                                                    <div className={`w-10 h-10 rounded-xl flex items-center justify-center ${loan.pagado ? 'bg-emerald-100 text-emerald-600' : 'bg-amber-100 text-amber-600'}`}>
                                                        <Icon name={loan.pagado ? "check-circle-2" : "clock"} size={20} />
                                                    </div>
                                                    <div>
                                                        <p className={`font-bold text-sm ${loan.pagado ? 'line-through text-slate-400' : 'text-slate-800'}`}>{loan.nombre}</p>
                                                        <span className="text-[10px] text-slate-400 font-bold uppercase">{loan.fecha}</span>
                                                    </div>
                                                </div>
                                                <div className="flex items-center gap-6">
                                                    <span className="text-base font-bold text-slate-900">{fmt(loan.monto)}</span>
                                                    <div className="flex items-center gap-2">
                                                        <button onClick={() => toggleLoanStatus(loan.id)} className={`text-[10px] font-bold uppercase px-4 py-2 rounded-lg border transition-all ${loan.pagado ? 'bg-white border-slate-200 text-slate-400' : 'bg-emerald-600 text-white'}`}>
                                                            {loan.pagado ? 'Pendiente' : 'Pagado'}
                                                        </button>
                                                        <button onClick={() => deleteLoan(loan.id)} className="text-slate-300 hover:text-rose-500 p-2"><Icon name="trash-2" size={18} /></button>
                                                    </div>
                                                </div>
                                            </div>
                                        ))}
                                    </div>
                                </div>
                            )}

                            {MONTHS.includes(activeTab) && (
                                <div className="max-w-6xl mx-auto space-y-10">
                                    <header className="flex flex-col sm:flex-row justify-between items-start sm:items-center gap-4">
                                        <h2 className="text-4xl font-bold text-slate-900 tracking-tight">{activeTab}</h2>
                                        <div className="bg-white border border-slate-200 px-6 py-4 rounded-2xl flex items-center gap-4 shadow-sm">
                                            <div className="text-center border-r border-slate-100 pr-4">
                                                <span className="text-[10px] font-bold text-slate-400 uppercase block">Ingresos</span>
                                                <span className="text-lg font-bold text-slate-800">{fmt(totalIngresos)}</span>
                                            </div>
                                            <div className="text-center">
                                                <span className="text-[10px] font-bold text-slate-400 uppercase block">Gastos</span>
                                                <span className="text-lg font-bold text-slate-800">{fmt(totalGastadoTotal)}</span>
                                            </div>
                                        </div>
                                    </header>

                                    <section className="bg-white p-8 rounded-2xl border border-slate-200 shadow-sm space-y-6">
                                        <h3 className="font-bold text-slate-800 text-sm flex items-center gap-2 uppercase tracking-widest"><Icon name="arrow-up-circle" color="#10b981" /> Flujo de Caja</h3>
                                        <div className={`grid gap-6 ${isMobileMode ? 'grid-cols-1' : 'grid-cols-2 lg:grid-cols-4'}`}>
                                            {[{l:'Sueldo Base',k:'salario'},{l:'Extra',k:'entradas'},{l:'Mes Pasado',k:'mesPasado'},{l:'Prestado',k:'prestado'}].map(i => (
                                                <div key={i.k} className="bg-slate-50 p-5 rounded-xl border border-slate-200 focus-within:bg-white focus-within:ring-2 focus-within:ring-indigo-100 transition-all">
                                                    <label className="text-[10px] font-bold text-slate-400 uppercase mb-2 block">{i.l}</label>
                                                    <div className="flex items-center gap-2 font-bold text-lg text-slate-800">
                                                        <span className="text-slate-300">€</span>
                                                        <input type="number" className="bg-transparent border-none w-full p-0 outline-none" placeholder="0.00" value={currentMonthData[i.k] || ''} onChange={(e)=>updateMonth(activeTab,i.k,e.target.value)} />
                                                    </div>
                                                </div>
                                            ))}
                                        </div>
                                    </section>

                                    <section className="bg-slate-900 text-white p-8 rounded-2xl shadow-xl flex flex-col md:flex-row justify-between items-center gap-6">
                                        <div className="flex items-center gap-5">
                                            <div className="bg-white/10 p-4 rounded-2xl"><Icon name="piggy-bank" color="#818cf8" size={32} /></div>
                                            <div><h4 className="font-bold text-lg">Ahorro Manual (Prioridad)</h4><p className="text-indigo-200 text-xs opacity-70">Este monto se bloquea primero.</p></div>
                                        </div>
                                        <div className="bg-white/5 p-4 rounded-xl border border-white/10 w-full md:w-64 text-center">
                                            <div className="flex items-center justify-center gap-3">
                                                <span className="text-indigo-400 font-bold text-2xl">€</span>
                                                <input type="number" className="bg-transparent border-none p-0 text-3xl font-bold text-white outline-none w-full text-center" placeholder="0.00" value={currentMonthData.ahorroManual || ''} onChange={(e)=>updateMonth(activeTab,'ahorroManual',e.target.value)} />
                                            </div>
                                        </div>
                                    </section>

                                    <div className={`grid gap-8 ${isMobileMode ? 'grid-cols-1' : 'grid-cols-3'}`}>
                                        <div className="lg:col-span-2 bg-white p-8 rounded-2xl border border-slate-200 shadow-sm space-y-10">
                                            <div className="flex justify-between items-center"><h3 className="font-bold text-xs uppercase tracking-widest text-slate-800 flex items-center gap-2"><Icon name="settings" color="#4f46e5" /> Regla de Distribución (%)</h3>{!isConfigValid && <span className="text-[10px] text-rose-500 font-bold animate-pulse">Suma debe ser 100%</span>}</div>
                                            <div className="space-y-10">
                                                {[{l:'Necesidades',k:'pNec',c:'accent-indigo-600',v:valNec,i:'arrow-down-circle'},{l:'Deseos',k:'pDes',c:'accent-pink-600',v:valDes,i:'tag'},{l:'Extra (%)',k:'pAho',c:'accent-emerald-600',v:valAhoExtra,i:'trending-up'}].map(i=>(
                                                    <div key={i.k} className="flex flex-col sm:flex-row items-center gap-8">
                                                        <div className="w-full sm:w-48">
                                                            <div className="flex items-center gap-2 mb-1"><Icon name={i.i} size={14} color="#94a3b8" /><label className="text-[10px] font-bold text-slate-400 uppercase">{i.l}</label></div>
                                                            <span className="text-lg font-bold text-slate-800">{data.config[i.k]}%</span>
                                                        </div>
                                                        <div className="flex-1 w-full"><input type="range" min="0" max="100" className={`w-full h-2 rounded-lg cursor-pointer ${i.c}`} value={data.config[i.k]} onChange={(e)=>updateConfig(i.k,e.target.value)} /></div>
                                                        <div className="w-full sm:w-32 bg-slate-50 px-4 py-2 rounded-xl text-center border border-slate-100 font-bold text-slate-600 text-xs">{fmt(i.v)}</div>
                                                    </div>
                                                ))}
                                            </div>
                                        </div>
                                        <div className="bg-white p-8 rounded-2xl border border-slate-200 shadow-sm flex flex-col items-center justify-center">
                                            <h3 className="font-bold text-[10px] text-slate-400 uppercase mb-4 tracking-widest text-center">Saldo Disponible Real</h3>
                                            <div className="h-64 w-full relative flex items-center justify-center">
                                                <div className="absolute flex flex-col items-center justify-center z-10 pointer-events-none">
                                                    <span className={`text-4xl font-bold tracking-tighter ${dineroDisponibleVista < 0 ? 'text-rose-500 animate-pulse' : 'text-slate-800'}`}>{fmt(dineroDisponibleVista)}</span>
                                                    <span className="text-[9px] font-bold text-slate-400 uppercase mt-1">Sobrante</span>
                                                </div>
                                                <ResponsiveContainer width="100%" height="100%"><PieChart margin={{top:10,right:10,bottom:10,left:10}}><Pie data={[{v:totalGastadoTotal,fill:dineroDisponibleVista<0?'#f43f5e':'#4f46e5'},{v:Math.max(0,dineroDisponibleVista),fill:'#f1f5f9'}]} innerRadius={75} outerRadius={95} paddingAngle={8} dataKey="v" stroke="none" startAngle={90} endAngle={450} /></PieChart></ResponsiveContainer>
                                            </div>
                                        </div>
                                    </div>

                                    <div className={`grid gap-8 ${isMobileMode ? 'grid-cols-1' : 'grid-cols-2'}`}>
                                        <div className={`bg-white p-8 rounded-2xl border ${isNecOver ? 'border-rose-200 bg-rose-50/20' : 'border-slate-200 shadow-sm'}`}>
                                            <div className="flex justify-between items-center mb-8"><div><h3 className="font-bold text-lg tracking-tight">Fijos (50%)</h3><p className="text-[10px] font-bold text-slate-400 uppercase">Límite: {fmt(valNec)}</p></div><button onClick={()=>addGasto(activeTab,'gastosFijos')} className="bg-slate-900 text-white p-2 rounded-xl shadow-md"><Icon name="plus" size={20} /></button></div>
                                            <div className="space-y-3">
                                                {currentMonthData.gastosFijos.map(g => (
                                                    <div key={g.id} className="flex flex-row items-center gap-3 group bg-white border border-slate-100 p-2.5 rounded-xl">
                                                        <input className="flex-1 bg-transparent border-none text-sm font-semibold outline-none text-slate-700 min-w-0" placeholder="Descripción" value={g.nombre} onChange={(e)=>updateGasto(activeTab,'gastosFijos',g.id,'nombre',e.target.value)} />
                                                        <div className="flex items-center bg-slate-50 rounded-lg px-3 py-2 border border-slate-200 w-32 shrink-0"><span className="text-slate-300 text-xs font-bold mr-1">€</span><input type="number" className="w-full bg-transparent border-none p-0 text-sm font-bold text-slate-800 outline-none text-right" placeholder="0" value={g.valor || ''} onChange={(e)=>updateGasto(activeTab,'gastosFijos',g.id,'valor',e.target.value)} /></div>
                                                        <button onClick={()=>deleteGasto(activeTab,'gastosFijos',g.id)} className="text-slate-200 hover:text-rose-500 shrink-0"><Icon name="trash-2" size={18} /></button>
                                                    </div>
                                                ))}
                                            </div>
                                        </div>
                                        <div className={`bg-white p-8 rounded-2xl border ${isDesOver ? 'border-rose-200 bg-rose-50/20' : 'border-slate-200 shadow-sm'}`}>
                                            <div className="flex justify-between items-center mb-8"><div><h3 className="font-bold text-lg tracking-tight">Variables (30%)</h3><p className="text-[10px] font-bold text-slate-400 uppercase">Límite: {fmt(valDes)}</p></div><button onClick={()=>addGasto(activeTab,'gastosVariables')} className="bg-slate-900 text-white p-2 rounded-xl shadow-md"><Icon name="plus" size={20} /></button></div>
                                            <div className="space-y-4">
                                                {currentMonthData.gastosVariables.map(g => (
                                                    <div key={g.id} className="flex flex-col gap-3 bg-white border border-slate-100 p-4 rounded-xl shadow-sm">
                                                        <div className="flex items-center gap-3">
                                                            <select className="bg-indigo-50 border-none rounded-lg px-3 py-1.5 text-[9px] font-bold text-indigo-700 outline-none" value={g.tag} onChange={(e)=>updateGasto(activeTab,'gastosVariables',g.id,'tag',e.target.value)}>{TAGS.map(t=><option key={t} value={t}>{t}</option>)}</select>
                                                            <input className="flex-1 min-w-0 bg-transparent border-none text-sm font-semibold outline-none text-slate-700" placeholder="¿Qué compraste?" value={g.nombre} onChange={(e)=>updateGasto(activeTab,'gastosVariables',g.id,'nombre',e.target.value)} />
                                                            <button onClick={()=>deleteGasto(activeTab,'gastosVariables',g.id)} className="text-slate-200 hover:text-rose-500 shrink-0"><Icon name="trash-2" size={18} /></button>
                                                        </div>
                                                        <div className="flex items-center bg-slate-50 rounded-xl px-5 py-2.5 border border-slate-200 self-end w-full sm:w-44"><span className="text-slate-300 text-sm font-bold mr-2">€</span><input type="number" className="w-full bg-transparent border-none p-0 text-sm font-bold text-slate-800 outline-none text-right" placeholder="0" value={g.valor || ''} onChange={(e)=>updateGasto(activeTab,'gastosVariables',g.id,'valor',e.target.value)} /></div>
                                                    </div>
                                                ))}
                                            </div>
                                        </div>
                                    </div>

                                    {categoryData.length > 0 && (
                                        <div className="bg-white p-10 rounded-2xl border border-slate-200 shadow-sm"><h3 className="text-sm font-bold text-slate-400 uppercase tracking-widest mb-10 flex items-center gap-3"><Icon name="tag" size={16} /> Distribución por Etiqueta</h3><div className="h-[400px] w-full"><ResponsiveContainer width="100%" height="100%"><BarChart data={categoryData} layout="vertical" margin={{left:20,right:60,top:20,bottom:20}}><CartesianGrid strokeDasharray="3 3" horizontal={false} stroke="#F1F5F9" /><XAxis type="number" hide /><YAxis dataKey="name" type="category" axisLine={false} tickLine={false} fontSize={11} width={80} tick={{fill:'#64748B',fontWeight:'bold'}} /><Tooltip cursor={{fill:'rgba(79,229,0.05)'}} contentStyle={{borderRadius:'15px',border:'none',boxShadow:'0 10px 15px -3px rgb(0 0 0 / 0.1)'}} /><Bar dataKey="value" radius={[0,10,10,0]} barSize={35}>{categoryData.map((e,idx)=>(<Cell key={idx} fill={COLORS[idx%COLORS.length]} />))}<LabelList dataKey="value" position="right" formatter={(v)=>fmt(v)} style={{fontWeight:'bold',fontSize:'13px',fill:'#1e293b'}} /></Bar></BarChart></ResponsiveContainer></div></div>
                                    )}
                                </div>
                            )}
                        </main>

                        {isMobileMode && (
                            <nav className="absolute bottom-0 left-0 right-0 bg-white/95 backdrop-blur-md border-t border-slate-100 h-24 flex justify-around items-center px-6 pb-8 z-50">
                                <button onClick={()=>{setActiveTab('Ahorros');setShowMonthSelector(false);}} className={`flex flex-col items-center gap-1.5 flex-1 ${activeTab==='Ahorros'?'text-indigo-600 scale-110':'text-slate-300'}`}><Icon name="piggy-bank" size={24} /><span className="text-[9px] uppercase tracking-tighter font-bold">Bóveda</span></button>
                                <div className="flex-1 flex justify-center"><button onClick={()=>setShowMonthSelector(!showMonthSelector)} className="bg-slate-900 text-white p-5 rounded-2xl shadow-xl active:scale-90 transition-all border-4 border-white -translate-y-10"><Icon name="calendar" size={28} /></button>
                                    {showMonthSelector && (<div className="absolute bottom-32 left-1/2 -translate-x-1/2 bg-white rounded-3xl p-6 shadow-2xl border border-slate-200 grid grid-cols-3 gap-3 w-72 z-[200] animate-in zoom-in duration-300">{MONTHS.map(m=>(<button key={m} onClick={()=>{setActiveTab(m);setShowMonthSelector(false);}} className={`p-3 text-[10px] font-bold rounded-xl uppercase transition-colors ${activeTab===m?'bg-indigo-600 text-white shadow-md':'bg-slate-50 text-slate-500'}`}>{m.slice(0,3)}</button>))}</div>)}
                                </div>
                                <button onClick={()=>{setActiveTab('Préstamos');setShowMonthSelector(false);}} className={`flex flex-col items-center gap-1.5 flex-1 ${activeTab==='Préstamos'?'text-indigo-600 scale-110':'text-slate-300'}`}><Icon name="hand-coins" size={24} /><span className="text-[9px] uppercase tracking-tighter font-bold">Deudas</span></button>
                            </nav>
                        )}
                    </div>
                </div>
            );
        };

        const root = ReactDOM.createRoot(document.getElementById('root'));
        root.render(<App />);
    </script>
</body>
</html>
